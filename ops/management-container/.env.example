# =============================================================================
# AIĐiLàm Management Container — Environment Configuration
#
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env to version control — it may contain secrets.
# =============================================================================

# Docker socket path (default: standard Unix socket)
DOCKER_HOST=unix:///var/run/docker.sock

# SSH configuration path on host (for Git remote access)
# SSH_CONFIG_PATH=/root/.ssh

# Terminal type
TERM=xterm-256color

# Node.js version for NVM (used during image build)
# NODE_VERSION=24
